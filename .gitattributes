# 自有文本规范化；固定来源与校验字节不做换行转换。/ Normalize owned text; preserve pinned sources and checksum bytes.
* text=auto
components/**/vendor/** -text
components/read_pico/** -text
components/read_pico_pmu/** -text
components/epdiy/** -text
components/e0470_epaper_waveform/** -text
components/cst836u/** -text
components/sc7a20h/** -text
components/fca9555/** -text
components/sy7636a/** -text
components/pwm_audio/** -text
assets/fonts/** -text
tests/fixtures/** -text
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary

components/pn_cjson/vendor/** -text whitespace=-blank-at-eol,-blank-at-eof

components/pn_qr/vendor/** -text whitespace=-blank-at-eol,-blank-at-eof

# 发布固件按字节保存，保证 SHA256SUMS 校验。/ Keep release firmware byte-exact so SHA256SUMS verifies.
releases/** -text

# 网页安装器内的固定第三方包按字节保存。/ Keep the pinned third-party installer bundle byte-exact.
installer/vendor/** -text

# USB许可摘要按原始字节验证。/ Validate USB license digests against their original bytes.
LICENSES/esp-tinyusb-LICENSE.txt -text
LICENSES/tinyusb-LICENSE.txt -text

# 归档浏览副本的摘要按字节保存，原始ZIP也不做换行转换。/ Keep archive digest bytes and original ZIP snapshots without line-ending conversion.
docs/archive/** -text
