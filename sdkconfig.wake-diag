# 唤醒诊断：保留真实浅睡/自动锁屏，增加INFO与内部小记录；不启动测试控制台。
# Wake diagnostics retain real sleep/idle locking, adding INFO and small internal records without a test console.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_PN_PROFILE=n
CONFIG_PN_TEST_CONSOLE=n
CONFIG_PN_DIAG_NO_AUTO_LOCK=n
CONFIG_PN_DIAG_NO_LOCK_SLEEP=n
CONFIG_PN_WAKE_TRACE=y
