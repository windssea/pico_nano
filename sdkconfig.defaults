CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 实验性组合：MSPI 的 flash 与 PSRAM 共用时钟域，CPU 240MHz 下 IDF 只标定了
# 模块时钟 120MHz，所以 PSRAM 想上 120MHz，flash 必须一起 120MHz。
# 渲染线程逐行读 PSRAM 里的 framebuffer，80MHz 时的实效带宽（约 32MB/s）
# 就是刷新速度的天花板。flash 侧靠 main/flash_hpm_zb.c 补上本机型号的高性能模式。
# 已知风险：上电后温度漂移约 20℃ 会让 PSRAM 访问随机出错。IDF 的温度补偿
# （SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR）只对 flash vendor
# 0xC8/0x20 验证过，本机是 ZB25VQ128(Zbit)，开了会在 do_system_init_fn 里报
# 「flash model has not been verified」直接 abort 并循环重启，所以必须关掉，
# 等于没有这层保护。别改成 y。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
# 显式启用 HPM（AUTO 会因为"依赖具体 flash 型号"报 #warning，-Werror 下编不过）。
# 本机 flash 靠写状态寄存器进入高性能模式，不需要调 dummy cycle，所以关掉 HPM-DC。
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n
CONFIG_SPIRAM_USE_MALLOC=y
# 传输文件任务用SDK能力分配PSRAM栈，保留内部RAM给无线。/ Allocate the file-transfer task stack in PSRAM through SDK capabilities, reserving internal RAM for radio.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# PNG 解码的有界局部缓冲需要额外栈空间。/ Bounded PNG decoder locals need additional stack space.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# USB/WiFi共存交给SDK，避免手动切换pad后主机无法重新枚举；不影响充电。
# Let the SDK manage USB/WiFi coexistence, avoiding failed host re-enumeration after manual pad switching; charging is unchanged.
CONFIG_ESP_PHY_ENABLE_USB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 非热路径节省Flash；阅读热路径由根CMake显式保留O2。/ Save flash outside hot paths; root CMake explicitly retains O2 for reading.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 正式版保留警告/错误，诊断配置恢复INFO。/ Retain release warnings/errors; diagnostics restore INFO.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y


# SHA书目文件名与书签ID须完整保留。/ Preserve SHA filenames and bookmark IDs.
CONFIG_LITTLEFS_OBJ_NAME_LEN=96

# 动态调频：空闲降到80MHz（仍为PLL时钟，不切MSPI低速），工作时由owner锁保持最高频；自动浅睡未启用。
# DFS: idle drops to 80 MHz (still PLL, no MSPI low-speed switch); owners hold max while working; automatic light sleep stays off.
CONFIG_PM_ENABLE=y
# 自动浅睡：tickless空闲在无锁时进入浅睡；插电脑USB时保持唤醒，日志与网页刷写可用。
# Automatic light sleep: tickless idle sleeps when no lock is held; stay awake while a USB host is connected for logs and web flashing.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# 手动独占TF的USB MSC；不自动挂载或格式化。/ Manual exclusive TF MSC; no automatic mount/format.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="PicoNano"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="PicoNano TF Card"
CONFIG_TINYUSB_DESC_MSC_STRING="PicoNano TF Card"
CONFIG_TINYUSB_MSC_MOUNT_PATH="/usb-unmounted"

# OTA资格镜像：公钥可公开，私钥留在仓库外；实际回滚仍需设备验证。
# OTA qualification image: public key only; keep signing secrets outside the repository and verify rollback on hardware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PN_DEVICE_OTA=y
# TLS握手缓冲使用PSRAM，避免WiFi/OTA worker耗尽内部连续堆；证书和验签策略不变。
# Put TLS handshake buffers in PSRAM so WiFi/OTA workers do not exhaust contiguous internal heap; certificate and signature policies stay unchanged.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_PN_OTA_PUBLIC_KEY_HEX="04f2ce42405655dfa24054164f286172ec8c6bef48bd17a31b5b375f786f1ad586f52164ec09d0326d144d8277febd70f930a39b7225db7fbec0d7a133307085cd"

# 传书网络：WiFi/lwIP动态缓冲优先放PSRAM，放大TCP窗口与套接字上限（网页80与LocalSend53317两个监听）。
# Transfer networking: prefer PSRAM for WiFi/lwIP dynamic buffers, widen TCP windows and the socket limit (web 80 plus LocalSend 53317 listeners).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_WND_DEFAULT=17280
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
# 自有大静态表（波形派生、水波纹载体、旁图名缓存）可标EXT_RAM_BSS放PSRAM。/ Own large static tables (derived waveforms, ripple carrier, sidecar names) may use EXT_RAM_BSS in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# 只读TF文件用64词簇链图加速字体/章节回跳，图不足由SDK退回原寻址；每个打开的只读文件增加256B SDK堆。
# Read-only TF files use a 64-word cluster map for font/chapter seeks; SDK falls back when the map is too small, adding 256 bytes of SDK heap per open read-only file.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
