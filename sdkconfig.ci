# CI 只验证代码能编过，不追求真机上的性能配置。
# 120MHz flash + PSRAM、HPM 和温度补偿都依赖具体的 flash 型号（本机 Zbit 0x5E），
# 在容器里既测不出来也没必要，所以这里退回到默认时序，其余保持和真机一致。
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# 与产品的 PNG 解码栈预算一致。/ Match the product PNG decoding stack budget.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 与产品的USB/无线互斥行为一致，仅时序保持CI隔离。 / Match product USB/radio exclusion while keeping CI timing isolated.
CONFIG_ESP_PHY_ENABLE_USB=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
# 长文件名 API 与产品配置一致，保证中文路径按 UTF-8 往返。
# Match the product filename API so Chinese paths round-trip as UTF-8.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y


# SHA书目文件名与书签ID须完整保留。/ Preserve SHA filenames and bookmark IDs.
CONFIG_LITTLEFS_OBJ_NAME_LEN=96

# 动态调频：空闲降到80MHz（仍为PLL时钟，不切MSPI低速），工作时由owner锁保持最高频；自动浅睡未启用。
# DFS: idle drops to 80 MHz (still PLL, no MSPI low-speed switch); owners hold max while working; automatic light sleep stays off.
CONFIG_PM_ENABLE=y
# 自动浅睡：tickless空闲在无锁时进入浅睡；插电脑USB时保持唤醒，日志与网页刷写可用。
# Automatic light sleep: tickless idle sleeps when no lock is held; stay awake while a USB host is connected for logs and web flashing.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# 手动独占TF的USB MSC；不自动挂载或格式化。/ Manual exclusive TF MSC; no automatic mount/format.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="PicoNano"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="PicoNano TF Card"
CONFIG_TINYUSB_DESC_MSC_STRING="PicoNano TF Card"
CONFIG_TINYUSB_MSC_MOUNT_PATH="/usb-unmounted"